---
import Layout from '../../layouts/Layout.astro';
import PriceCalculator from '../../components/PriceCalculator.astro';
import { fetchActions, isFree, modeLabel, installUrl, formatCount, formatPrice, type Action } from '../../lib/actions';

export async function getStaticPaths() {
  const actions = await fetchActions();
  return actions.map((action) => ({
    params: { slug: action.id },
    props: { action },
  }));
}

const { action } = Astro.props as { action: Action };

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}/actions/${action.id}/`;
const seoTitle = `${action.title} - Scryptian`;
const seoDescription = (
  action.long_description ||
  action.description ||
  `Install ${action.title} and run it on any text with a hotkey.`
).slice(0, 160);

const mainSite = 'https://scryptian.com';

const slipperPrice = (action.price > 0 ? action.price : action.price_per_unit || 0) / 1000;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: action.title,
  description: action.long_description || action.description,
  applicationCategory: action.category || 'UtilitiesApplication',
  operatingSystem: 'Windows',
  url: canonical,
  ...(action.demo_gif ? { image: action.demo_gif } : {}),
  author: { '@type': 'Organization', name: action.author || 'Scryptian' },
  offers: {
    '@type': 'Offer',
    price: isFree(action) ? '0' : String(slipperPrice),
    priceCurrency: 'SLP',
  },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  schema={schema}
>
  <section class="landing">
    <div class="container">
      <div class="landing-head">
        <h1>{action.title}</h1>
        <p class="tagline">{action.description}</p>
        {action.tags && action.tags.length > 0 && (
          <div class="tag-list">
            {action.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <div class="landing-grid">
        <div class="landing-main">
          <div class="panel demo">
            {action.demo_gif ? (
              <img src={action.demo_gif} alt={action.description} loading="eager" fetchpriority="high" />
            ) : (
              <div class="demo-placeholder">
                <span>Demo coming soon</span>
              </div>
            )}
          </div>

          {action.features && action.features.length > 0 && (
            <div class="panel">
              <h2 class="panel-title">What this action does</h2>
              <ul class="feature-list">
                {action.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
          )}

          <div class="panel prose">
            {action.long_description ? (
              action.long_description
                .split(/\r?\n\s*\r?\n/)
                .filter((paragraph) => paragraph.trim())
                .map((paragraph) => <p>{paragraph.trim()}</p>)
            ) : (
              <p>
                {action.title} runs directly from the Scryptian bar. Select text anywhere,
                press the hotkey, and apply this action without leaving your current window.
              </p>
            )}
          </div>
        </div>

        <aside class="landing-side">
          <div class="panel buy-box">
            <div class="price-row">
              <span class="price">{isFree(action) ? 'Free to Use' : formatPrice(action)}</span>
              <span class="mode">{modeLabel(action)}</span>
            </div>

            <PriceCalculator price={action.price} pricePerUnit={action.price_per_unit} unit={action.unit} isFree={isFree(action)} />

            {/* Old download buttons (kept for future reference)
            <a class="install-btn" href={installUrl(action)} data-ph-event="action_install_clicked" data-ph-props={JSON.stringify({ action_id: action.id, title: action.title })}>Add To Scryptian</a>
            <a class="install-btn secondary" href={mainSite} target="_blank" rel="noopener" data-ph-event="install_scryptian_clicked" data-ph-props={JSON.stringify({ action_id: action.id })}>Install Scryptian With This Action</a>
            */}

            <a class="install-btn" href="https://github.com/adrianium/Scryptian/releases/download/v0.1.0/Scryptian_Setup.exe">Download for Windows</a>
            <p class="bonus-hint">~30 MB · 2,000 free Slippers (~$2) included</p>

            <a class="what-is" href={mainSite} target="_blank" rel="noopener" data-ph-event="what_is_scryptian_clicked">What is Scryptian?</a>
          </div>

          <div class="panel specs">
            <div class="spec">
              <span class="label">Mode</span>
              <span class="value">{modeLabel(action)}</span>
            </div>
            <div class="spec">
              <span class="label">Price</span>
              <span class="value">{isFree(action) ? 'Free to Use' : formatPrice(action)}</span>
            </div>
            <div class="spec">
              <span class="label">Runs</span>
              <span class="value">{formatCount(action.runs_count)}</span>
            </div>
            <div class="spec">
              <span class="label">Installs</span>
              <span class="value">{formatCount(action.installs_count)}</span>
            </div>
            <div class="spec">
              <span class="label">Version</span>
              <span class="value">v{action.version}</span>
            </div>
            <div class="spec">
              <span class="label">Author</span>
              <span class="value">{action.author || 'Scryptian'}</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="how-it-works">
    <div class="container">
      <h2 class="how-title">How it works</h2>
      <ol class="how-steps">
        <li class="how-step">
          <span class="how-num">1</span>
          <div>
            <h3>Download</h3>
            <p>Free app for Windows.</p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">2</span>
          <div>
            <h3>Copy a file</h3>
            <p>Select any file</p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">3</span>
          <div>
            <h3>Press Ctrl+Alt</h3>
            <p>The bar opens over your file.</p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">4</span>
          <div>
            <h3>Pick this action</h3>
            <p>Done. Pay only for the result.</p>
          </div>
        </li>
        <li class="how-step">
          <span class="how-num">5</span>
          <div>
            <h3>Result file</h3>
            <p>Result files appears in the same place where original.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>
</Layout>
