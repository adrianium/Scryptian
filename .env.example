# Supabase project URL, for example: https://your-project.supabase.co
SUPABASE_URL=

# Supabase public anon key. Never put the service_role key here.
SUPABASE_ANON_KEY=

# Supabase table and public Storage bucket names
SUPABASE_SKILLS_TABLE=actions
SUPABASE_STORAGE_BUCKET=actions

# Google Cloud Translation (used by the "Translate PDF to English" skill)
# Path to the downloaded service account JSON key.
GOOGLE_KEY_PATH=
GOOGLE_PROJECT_ID=
